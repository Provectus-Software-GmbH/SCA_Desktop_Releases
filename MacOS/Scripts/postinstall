#!/bin/bash
set -euo pipefail

LABEL="de.provectus.securecontacts.updater"
UPDATER="/Library/Application Support/SecureContacts/IntuneBootstrap/Install-SecureContacts.sh"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
LOG_DIR="/Library/Logs/SecureContacts"

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
  echo "Secure Contacts installation must run as root." >&2
  exit 1
fi

if [ ! -x "$UPDATER" ]; then
  echo "Bundled updater is missing or not executable: $UPDATER" >&2
  exit 1
fi

/bin/mkdir -p "$LOG_DIR"
/usr/sbin/chown root:wheel "$LOG_DIR"
/bin/chmod 0755 "$LOG_DIR"

echo "Installing Secure Contacts update schedule."
/bin/cat >"$PLIST" <<'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.provectus.securecontacts.updater</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Library/Application Support/SecureContacts/IntuneBootstrap/Install-SecureContacts.sh</string>
  </array>

  <!-- Check for a GitHub release every six hours. -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <!-- Also check after the LaunchDaemon is loaded at system startup. -->
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Library/Logs/SecureContacts/launchdaemon.log</string>

  <key>StandardErrorPath</key>
  <string>/Library/Logs/SecureContacts/launchdaemon-error.log</string>
</dict>
</plist>
PLIST_EOF

/usr/sbin/chown root:wheel "$PLIST"
/bin/chmod 0644 "$PLIST"
/usr/bin/plutil -lint "$PLIST"

if /bin/launchctl print "system/$LABEL" >/dev/null 2>&1; then
  /bin/launchctl bootout "system/$LABEL" || true
fi

/bin/launchctl enable "system/$LABEL"
/bin/launchctl bootstrap system "$PLIST"

echo "Secure Contacts updater scheduled every six hours."
echo "Running initial Secure Contacts update check."
if ! /bin/bash "$UPDATER"; then
  echo "Initial Secure Contacts update check failed; the scheduled updater remains installed." >&2
fi

exit 0
